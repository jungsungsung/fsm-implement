#define _CRT_SECURE_NO_WARNINGS

#include "sensor.h"
#include <stdio.h>
#include <windows.h>

// 시나리오 파일 한 줄이 "현실에서" 유지되는 시간 (기존 1틱 = 200ms)
#define SENSOR_PERIOD_MS 200

// 센서 스레드가 쓰고 컨트롤러가 읽는 공유 데이터
static CRITICAL_SECTION g_lock;
static ObstacleInfo g_obstacle = { 0, 0, 0 };
static int g_dust = 0;

static HANDLE g_changedEvent = NULL;   // 값이 바뀌면 SetEvent (인터럽트)
static HANDLE g_thread = NULL;
static volatile LONG g_finished = 0;
static volatile LONG g_stop = 0;

static FILE *front_fp = NULL;
static FILE *left_fp = NULL;
static FILE *right_fp = NULL;
static FILE *dust_fp = NULL;

//Front / Left / Right / Dust Sensor Interface
//하드웨어에서 값 하나를 읽어오는 부분 (지금은 파일로 흉내냄). 실패 시 0
static int ReadFront(int *value) { return fscanf(front_fp, "%d", value) == 1; }
static int ReadLeft(int *value)  { return fscanf(left_fp, "%d", value) == 1; }
static int ReadRight(int *value) { return fscanf(right_fp, "%d", value) == 1; }
static int ReadDust(int *value)  { return fscanf(dust_fp, "%d", value) == 1; }

// 센서 하드웨어 시뮬레이션 스레드
// 컨트롤러가 무엇을 하든(회전 중이든 후진 중이든) 독립적으로 계속 샘플링하고,
// 값이 바뀌는 순간 이벤트를 울려서 컨트롤러를 즉시 깨운다.
static DWORD WINAPI SensorThread(LPVOID arg)
{
    (void)arg;

    while (!g_stop) {
        ObstacleInfo o;
        int dust;

        if (!ReadFront(&o.front) || !ReadLeft(&o.left) ||
            !ReadRight(&o.right) || !ReadDust(&dust)) {
            break;  // 시나리오 끝
        }

        EnterCriticalSection(&g_lock);
        int changed = o.front != g_obstacle.front ||
                      o.left  != g_obstacle.left  ||
                      o.right != g_obstacle.right ||
                      dust    != g_dust;
        g_obstacle = o;
        g_dust = dust;
        LeaveCriticalSection(&g_lock);

        if (changed) {
            SetEvent(g_changedEvent);
        }

        Sleep(SENSOR_PERIOD_MS);
    }

    InterlockedExchange(&g_finished, 1);
    SetEvent(g_changedEvent);  // 대기 중인 메인 루프를 깨워서 종료하게 함
    return 0;
}

int SensorInit(void)
{
    fopen_s(&front_fp, "front.txt", "r");
    fopen_s(&left_fp, "left.txt", "r");
    fopen_s(&right_fp, "right.txt", "r");
    fopen_s(&dust_fp, "dust.txt", "r");

    if (!front_fp || !left_fp || !right_fp || !dust_fp) {
        return 0;
    }

    InitializeCriticalSection(&g_lock);
    // 자동 리셋 이벤트: WaitForSingleObject가 깨어나면 자동으로 다시 꺼짐
    g_changedEvent = CreateEvent(NULL, FALSE, FALSE, NULL);
    g_thread = CreateThread(NULL, 0, SensorThread, NULL, 0, NULL);

    return g_changedEvent != NULL && g_thread != NULL;
}

void SensorStop(void)
{
    InterlockedExchange(&g_stop, 1);
    if (g_thread) {
        WaitForSingleObject(g_thread, INFINITE);
        CloseHandle(g_thread);
    }
    if (g_changedEvent) CloseHandle(g_changedEvent);
    DeleteCriticalSection(&g_lock);

    if (front_fp) fclose(front_fp);
    if (left_fp) fclose(left_fp);
    if (right_fp) fclose(right_fp);
    if (dust_fp) fclose(dust_fp);
}

//Determine Obstacle Location
ObstacleInfo Det_OL(void)
{
    ObstacleInfo info;
    EnterCriticalSection(&g_lock);
    info = g_obstacle;
    LeaveCriticalSection(&g_lock);
    return info;
}

//Determine Dust Existence
int Det_DE(void)
{
    int dust;
    EnterCriticalSection(&g_lock);
    dust = g_dust;
    LeaveCriticalSection(&g_lock);
    return dust;
}

void *SensorChangedEvent(void)
{
    return g_changedEvent;
}

int SensorFinished(void)
{
    return g_finished != 0;
}
