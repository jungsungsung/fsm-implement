#include <stdio.h>
#include "controller.h"
#include "sensor.h"
#include <windows.h>

int main(void){

    SetConsoleOutputCP(CP_UTF8);
    SetConsoleCP(CP_UTF8);

    if (!SensorInit()) {
        printf("센서 파일(front/left/right/dust.txt)을 열 수 없습니다\n");
        return 1;
    }

    ControllerInit();

    HANDLE sensorChanged = (HANDLE)SensorChangedEvent();
    ULONGLONG start = GetTickCount64();

    // 고정 틱 없이: "센서 값이 바뀌거나" "타이머가 만료되는" 순간에만 깨어나서 처리
    while (!SensorFinished()) {
        DWORD timeout = ControllerNextTimeout(GetTickCount64());
        DWORD result = WaitForSingleObject(sensorChanged, timeout);
        if (SensorFinished()) break;

        ULONGLONG now = GetTickCount64();
        ObstacleInfo obstacle = Det_OL();
        int dust_Existence = Det_DE();

        if (result == WAIT_OBJECT_0) {
            printf("\n[%5llu ms] 센서 변화 감지 -> 앞:%d 왼:%d 오:%d 먼지:%d\n",
                   now - start, obstacle.front, obstacle.left, obstacle.right, dust_Existence);
        } else {
            printf("\n[%5llu ms] 타이머 만료\n", now - start);
        }

        Controller(obstacle, dust_Existence, now);
    }

    printf("\n시나리오 종료\n");
    SensorStop();
    return 0;
}
